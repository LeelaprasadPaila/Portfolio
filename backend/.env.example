# Backend Configuration (Node/Express)
# Copy these to Render's Dashboard or your local .env file

NODE_ENV=production
PORT=10000

# Your MongoDB cluster connection URL
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/portfolio

# Authentication and CORS
JWT_SECRET=SUPER_SECRET_CHANGE_ME
FRONTEND_URL=http://localhost:5173
FRONTEND_PROD_URL=https://your-portfolio.onrender.com

# Admin Panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_something_secure
