# Backend Configuration (Node/Express)
# Copy these to Render's Dashboard or your local .env file

NODE_ENV=production
PORT=10000

# Your MongoDB cluster connection URL
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/portfolio

# Authentication and CORS
JWT_SECRET=SUPER_SECRET_CHANGE_ME
FRONTEND_URL=http://localhost:5174
FRONTEND_PROD_URL=https://your-portfolio.onrender.com

# Admin Panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_something_secure

# ============================================
# EMAIL CONFIGURATION (for Contact Form)
# ============================================
# To enable visitors to send you emails via the contact form:
#
# 1. Go to https://myaccount.google.com/apppasswords
#    (Requires 2FA enabled on your Google account)
# 2. Create a new App Password named "Portfolio Contact Form"
# 3. Copy the 16-character password and paste it below
#
# EMAIL_SERVICE=gmail
# EMAIL_USER=pailalee99@gmail.com
# EMAIL_PASSWORD=xxxx xxxx xxxx xxxx (16-char app password)
# CONTACT_EMAIL_RECIPIENT=pailalee99@gmail.com