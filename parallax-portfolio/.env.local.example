"""
FRONTEND ENVIRONMENT VARIABLES

Copy this file to .env.local and fill in with your values.
Frontend variables are prefixed with VITE_ to be accessible in client code.
"""

# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000

# Admin Settings
VITE_ADMIN_PASSWORD=change-me-in-production

# Feature Flags
VITE_ENABLE_COMMENTS=true
VITE_MAINTENANCE_MODE=false

# Analytics (optional)
VITE_GA_ID=

# Build Settings
VITE_BUILD_MODE=development
