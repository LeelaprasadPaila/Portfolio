# Frontend Environment Configuration (Vite)
# Copy these to Render's Dashboard or your local .env file

# The base URL of your deployed backend (on Render)
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000
VITE_STORAGE_URL=http://localhost:5000/uploads
VITE_ENABLE_ANALYTICS=false

# Other optional flags
VITE_APP_NAME="Paila Portfolio"
VITE_PORT=5174
