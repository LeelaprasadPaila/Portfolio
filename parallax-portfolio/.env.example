# ============================================
# SPRINT 4 - ENVIRONMENT CONFIGURATION
# ============================================

# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_STORAGE_URL=http://localhost:5000/uploads

# Analytics - Google Analytics (Optional)
VITE_GA_ID=G-XXXXXXXXXX

# Analytics - Plausible (Optional)
VITE_PLAUSIBLE_DOMAIN=yourdomain.com

# Analytics - PostHog (Optional)
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxx
VITE_POSTHOG_HOST=https://app.posthog.com

# Analytics - Microsoft Clarity (Optional)
VITE_CLARITY_ID=xxxxxxxxxx

# Application
VITE_APP_URL=https://leelaprasad.dev
VITE_APP_NAME=Paila Leela Prasad Portfolio

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_COMMAND_PALETTE=true
VITE_ENABLE_TOASTS=true
VITE_ENABLE_PWA=true

# Formspree - Contact Form Email Forwarding
# Get your form ID at: https://formspree.io/
# 1. Sign up at formspree.io (free tier: 50 submissions/month)
# 2. Create a new form
# 3. Copy the form ID from the URL (e.g., "xyzabcde" from https://formspree.io/f/xeeyvwjy)
VITE_FORMSPREE_ID=xeeyvwjy

# Development
VITE_DEV_MODE=true
