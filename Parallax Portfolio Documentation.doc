│   ├── parallax.css        # Parallax-specific styles
│   └── responsive.css      # Media query styles
├── js/
│   ├── parallax.js         # Parallax effect logic
│   ├── reveal.js           # Reveal animation
│   └── interactions.js     # Event handlers & utilities
├── images/
│   ├── layers/             # Parallax background layers
│   │   ├── layer-0-bg.png         # Background (farthest)
│   │   ├── layer-1-mountains.png  # Mountain range 1
│   │   ├── layer-2-mountains.png  # Mountain range 2
│   │   ├── layer-3-fog.png        # Fog/mist effect
│   │   ├── layer-4-trees.png      # Foreground trees
│   │   ├── layer-5-overlay.png    # Dark overlay vignette
│   │   └── layer-6-sun-rays.png   # Sun rays (static)
│   ├── projects/           # Project showcase images
